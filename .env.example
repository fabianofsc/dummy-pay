# Copy to .env and fill in real values for local development.
# .env is gitignored; never commit real credentials (ADR-0010).

DUMMYPAY_HTTP_ADDR=:8080
DUMMYPAY_DATABASE_URL=postgres://dummypay:dummypay@localhost:5432/dummypay?sslmode=disable
DUMMYPAY_ACCOUNT_KEY_ID=local-dev-account
DUMMYPAY_ACCOUNT_KEY_SECRET=change-me-to-a-long-random-value
# 32 bytes, base64-encoded. Generate with: openssl rand -base64 32
DUMMYPAY_WEBHOOK_SECRET_ENC_KEY=change-me-to-a-base64-encoded-32-byte-key

DUMMYPAY_PROCESSING_DELAY=3s
DUMMYPAY_IDEMPOTENCY_LEASE=30s
DUMMYPAY_WORKER_POLL_INTERVAL=250ms
DUMMYPAY_WEBHOOK_TIMEOUT=5s
